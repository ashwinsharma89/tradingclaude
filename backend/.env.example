# Zerodha Kite Connect (Primary Indian data source)
ZERODHA_API_KEY=your_api_key
ZERODHA_API_SECRET=your_api_secret
ZERODHA_ACCESS_TOKEN=your_access_token
ZERODHA_REQUEST_TOKEN=

# Upstox (Fallback Indian data source)
UPSTOX_CLIENT_ID=your_client_id
UPSTOX_CLIENT_SECRET=your_client_secret
UPSTOX_REDIRECT_URI=http://localhost:8000/auth/upstox/callback
UPSTOX_ACCESS_TOKEN=your_access_token

# Dhan (Indian data source)
DHAN_CLIENT_ID=your_dhan_client_id
DHAN_ACCESS_TOKEN=your_dhan_access_token

TWELVE_DATA_API_KEY=your_key
FRED_API_KEY=your_key

REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=900

# Primary data source — set to "zerodha", "upstox", or "dhan"
INDIAN_DATA_SOURCE=dhan
